# Server
NODE_ENV=development
PORT=8787

# Comma-separated list of allowed origins (no trailing slash).
# Example for production: https://hushcafe.example,https://www.hushcafe.example
SITE_URL=

# Admin bootstrap: used only by `npm run admin:create`. No default credentials exist.
HUSH_ADMIN_PASSWORD=

# Google Places (New) API key. Reviews stay disabled until this and a Place ID are set.
GOOGLE_PLACES_API_KEY=

# Per-branch Google Place IDs (set in Admin > Branches instead of env if preferred)
# GOOGLE_PLACE_ID_FOUAD=
# GOOGLE_PLACE_ID_FARAH=

# WhatsApp ordering (off by default). E.164 digits only, e.g. 201012345678
WHATSAPP_NUMBER=

# Upload limits
MAX_UPLOAD_MB=5
